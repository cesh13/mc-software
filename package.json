{
  "name": "accounting-platform",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @accounting/api dev",
    "dev:web": "pnpm --filter @accounting/web dev",
    "dev:tray": "pnpm --filter @accounting/tray dev",
    "build:api": "pnpm --filter @accounting/api build",
    "build:web": "pnpm --filter @accounting/web build",
    "build:tray": "pnpm --filter @accounting/tray build",
    "build:shared": "pnpm --filter @accounting/shared build",
    "db:generate": "pnpm --filter @accounting/api db:generate",
    "db:migrate": "pnpm --filter @accounting/api db:migrate",
    "dist:win": "pnpm --filter @accounting/tray dist:win",
    "dist:mac": "pnpm --filter @accounting/tray dist:mac"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3-multiple-ciphers",
      "electron",
      "esbuild",
      "keytar",
      "sharp"
    ]
  }
}
